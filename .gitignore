# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template, which holds only variable names and comments. Without
# this negation the `.env*` rule above swallows it too, and the one file whose
# whole job is to document required configuration never reaches the repo.
!.env.example

# vercel
.vercel

# local agent / editor config
.claude/

# GoHighLevel agent config, maintained locally and pasted into GHL
docs/ai-receptionist/knowledge-base.md
docs/ai-receptionist/system-prompt.md

# typescript
*.tsbuildinfo
next-env.d.ts
