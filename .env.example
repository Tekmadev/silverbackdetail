# =============================================================================
# Silverback Detailing — environment variables
# Copy to .env.local and fill in. EVERY value is optional for local dev:
# the site builds and runs with none set (integrations degrade gracefully).
# =============================================================================

# Site origin, used for canonical URLs, og:url, JSON-LD, the sitemap, and links
# in emails. Must be the host that actually serves the site: production is www,
# and the bare apex 308-redirects to it. Setting the apex here makes the site
# publish URLs that point at a redirect, and some clients will not follow one.
NEXT_PUBLIC_SITE_URL=https://www.silverbackdetail.com

# --- Storage provider --------------------------------------------------------
# "supabase" stores bookings in Postgres. "email" skips the DB and relies on the
# owner-notification email only. Defaults to "email" when Supabase keys are absent.
STORAGE_PROVIDER=email

# --- Stripe (booking deposits) ----------------------------------------------
# Without these, deposit checkout runs in DEMO mode (no charge, booking still
# confirms) so the flow is fully testable before Stripe is connected.
# Checkout is created server-side and the customer is redirected to Stripe's own
# hosted page, so no publishable key is needed in the browser.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Resend (transactional email) -------------------------------------------
# Without RESEND_API_KEY, emails are logged to the server console instead of sent.
RESEND_API_KEY=
# Verified "from" address on your Resend domain. Must be a domain verified in
# Resend (silverbackdetail.com, note there is no "ing"). A free-mail from address
# such as gmail.com is rejected and the send fails silently.
EMAIL_FROM="Silverback Detailing <book@silverbackdetail.com>"

# --- Supabase (optional booking storage) ------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin dashboard (/admin) ------------------------------------------------
# No extra variables. Access is granted in the database, not by env var, so
# adding or removing someone is a query rather than a redeploy.
#
# 1. Supabase > Authentication > Users > Add user (email + password)
# 2. Promote that address to role='admin' in public.profiles (see the query in
#    supabase/schema.sql). New accounts default to role='customer'.
#
# The dashboard reuses NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_ANON_KEY,
# and SUPABASE_SERVICE_ROLE_KEY above. Sign-in cannot work without all three.
